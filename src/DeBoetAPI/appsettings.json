{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "FileLogging": {
    "Enabled": true,
    "Directory": "logs",
    "FileName": "deboetapi-.log",
    "RetainedFileCountLimit": 30,
    "FileSizeLimitBytes": 104857600
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=deboetapi;Username=postgres;Password=postgres"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "deboetapi-api",
    "Audience": "deboetapi-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "OpenApi": {
    "Enabled": false
  },
  "RateLimit": {
    "AuthPermitPerMinute": 10
  },
  "Proxy": {
    "TrustForwardedHeaders": false
  },
  "Admin": {
    "SeedOnStartup": true,
    "Username": "admin",
    "Email": "admin@deboetapi.local",
    "Password": "deboet"
  }
}
