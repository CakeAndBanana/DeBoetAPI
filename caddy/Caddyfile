{
	# Let's Encrypt uses this for expiry warnings. Certificates are obtained and renewed
	# automatically — there is nothing to run on a schedule.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Health probes are for the deploy pipeline, which reaches the API directly on the host.
	# No reason to expose readiness (and its dependency detail) to the internet.
	handle /health* {
		respond 404
	}

	# API docs, served publicly. They only exist at all when the API runs with
	# OPENAPI_ENABLED=true; with it false these paths 404 from the API itself.
	#
	# To put them behind a password instead, generate a hash with
	#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
	# set DOCS_USER / DOCS_PASSWORD_HASH in .env, and add inside this handle block:
	#
	#   basic_auth {
	#       {$DOCS_USER} {$DOCS_PASSWORD_HASH}
	#   }
	handle /openapi* {
		reverse_proxy api:8080
	}

	handle /scalar* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy api:8080
	}
}

{$ADMIN_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The panel is not a public page and must never be indexed or framed.
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	reverse_proxy web:3000
}
