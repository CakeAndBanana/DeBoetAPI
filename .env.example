# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---
POSTGRES_DB=deboetapi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- JWT ---
# At least 32 characters. Generate one with:
#   pwsh:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#   bash:  openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-random-48-byte-base64-string
JWT_ISSUER=deboetapi-api
JWT_AUDIENCE=deboetapi-clients

# --- Production only (compose.prod.yaml) ---
IMAGE=ghcr.io/OWNER/deboetapi-api
IMAGE_TAG=latest
CORS_ORIGIN=https://your-site.example

# TLS. DOMAIN must already resolve to this server's public IP, and ports 80 + 443 must be
# reachable — Caddy proves control of the domain over both to obtain the certificate.
DOMAIN=api.your-site.example
ACME_EMAIL=you@your-site.example

# --- API docs ---
# Serves /openapi/v1.json and /scalar/v1 in production. Caddy does not proxy those paths, so
# they stay reachable only through an SSH tunnel:
#   ssh -L 8080:127.0.0.1:8080 you@your-vps  →  http://localhost:8080/scalar/v1
OPENAPI_ENABLED=false

# --- Bootstrap admin ---
# The API seeds an "admin" account on startup. Override the default password before going live.
ADMIN_PASSWORD=change-me-before-production
