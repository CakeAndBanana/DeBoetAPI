# Base URL of the API. In compose this is the service name on the internal network,
# so requests never leave the host and CORS never applies.
API_BASE_URL=http://api:8080

# Public site the categories are published on. The route shown on each card links here.
SITE_URL=https://www.deboet.nl

# Seals the session cookie. At least 32 characters; generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-32-plus-character-string
